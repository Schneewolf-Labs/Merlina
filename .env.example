# Merlina Configuration Template
# Copy this file to .env and customize for your environment

# ==========================================
# Server Configuration
# ==========================================

# Server host (0.0.0.0 allows external connections, 127.0.0.1 is localhost only)
HOST=0.0.0.0

# Server port
PORT=8000

# Production domain (leave empty for development)
# Examples:
#   http://localhost:8000
#   https://merlina.example.com
#   http://192.168.1.100:8000
# DOMAIN=

# ==========================================
# Directory Paths (Optional)
# ==========================================

# Uncomment to customize data directories
# DATA_DIR=./data
# MODELS_DIR=./models
# RESULTS_DIR=./results
# UPLOADS_DIR=./data/uploads
# FRONTEND_DIR=./frontend

# Database location
# DATABASE_PATH=./data/jobs.db

# ==========================================
# External Services — API Secrets
# ==========================================
# Setting these here means clients don't need to send the tokens in HTTP
# requests. The server will automatically fall back to these values for
# any training/upload/preload/inference request that omits them. A token
# sent in a request still overrides the env value.
#
# The GET /env/secrets endpoint reports which of these are configured
# (booleans only — never the values themselves) so the frontend can hide
# token fields when the server already has them.

# Weights & Biases API Key
# Get your key from: https://wandb.ai/authorize
# WANDB_API_KEY=

# HuggingFace Token (required for gated models like Llama, and for Hub uploads)
# Get your token from: https://huggingface.co/settings/tokens
# HF_TOKEN=

# ==========================================
# Training Defaults (Optional)
# ==========================================

# Default LoRA settings
# DEFAULT_LORA_R=64
# DEFAULT_LORA_ALPHA=32

# Default training hyperparameters
# DEFAULT_LEARNING_RATE=0.000005
# DEFAULT_BATCH_SIZE=1
# DEFAULT_GRADIENT_ACCUMULATION_STEPS=16
# DEFAULT_NUM_EPOCHS=2

# ==========================================
# Job Queue Configuration
# ==========================================

# Maximum number of training jobs to run simultaneously
# Set to 1 for safety (prevents OOM on single GPU)
# Increase if you have multiple GPUs with sufficient VRAM
# MAX_CONCURRENT_JOBS=1

# ==========================================
# Remote Execution (rented compute)
# ==========================================
# Bring-your-own-key remote mode: Merlina provisions GPU instances on YOUR
# provider account, runs training there, pulls the artifacts home, and
# terminates the instance. You pay the provider directly.

# RunPod API key (https://www.runpod.io/console/user/settings)
# RUNPOD_API_KEY=

# Container image the provisioned workers run (must contain Merlina)
# REMOTE_WORKER_IMAGE=ghcr.io/schneewolf-labs/merlina:latest

# Remote jobs have their own queue (they don't use the local GPU)
# REMOTE_MAX_CONCURRENT_JOBS=2

# Remote inference sessions (vLLM on a rented GPU; see docs/user/remote-inference.md)
# Image built from Dockerfile.serve:
# REMOTE_SERVE_IMAGE=ghcr.io/schneewolf-labs/merlina-serve:latest
# Each active session is a billing pod:
# REMOTE_MAX_INFERENCE_SESSIONS=2

# Polling cadence and safety timeouts
# REMOTE_POLL_INTERVAL_SECONDS=10
# REMOTE_BOOT_TIMEOUT_MINUTES=30
# REMOTE_STOP_GRACE_MINUTES=15
# How long worker status may stay unreachable before a running stage fails:
# REMOTE_STATUS_ERROR_TOLERANCE_MINUTES=10

# Directories remote local_file datasets may be staged from (comma separated).
# Empty refuses all remote local files. Staging also requires S3/R2 artifacts.
# REMOTE_LOCAL_DATA_ROOTS=/srv/merlina/datasets

# ==========================================
# System Configuration
# ==========================================

# GPU selection (comma-separated GPU IDs)
# Examples:
#   CUDA_VISIBLE_DEVICES=0        # Use only GPU 0
#   CUDA_VISIBLE_DEVICES=0,1      # Use GPUs 0 and 1
#   CUDA_VISIBLE_DEVICES=1,2,3    # Use GPUs 1, 2, and 3
# CUDA_VISIBLE_DEVICES=

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Offline mode: never contact the HuggingFace Hub. Models and datasets are
# loaded from the local HF cache or local paths only (sets HF_HUB_OFFLINE
# and TRANSFORMERS_OFFLINE). Use GET /models/local or the "Local Models"
# picker in the UI to see what's available offline.
OFFLINE_MODE=false

# ==========================================
# Unified-Memory Protection (DGX Spark / Grace-Blackwell)
# ==========================================
# On unified-memory machines (NVIDIA GB10 "DGX Spark", GH200/GB200, Jetson)
# the GPU and system RAM share one physical pool. A training memory spike
# there doesn't raise a clean CUDA OOM — it can starve the OS and take the
# whole machine down. Merlina's memory guard detects these systems, caps
# the CUDA allocator so spikes fail as ordinary OOMs, and runs a watchdog
# that gracefully stops (or, as a last resort, aborts) training before the
# OS runs out of RAM. It also writes an fsync'd forensic log to
# data/memory_guard.log so post-crash investigation has a memory timeline.
#
# The guard is a no-op on discrete-GPU systems. Defaults are tuned for a
# 128GB GB10; you rarely need to change anything.

# Master switch for the guard
# MEMORY_GUARD_ENABLED=true

# Detection override: auto (default) | true (force on) | false (force off)
# UNIFIED_MEMORY=auto

# RAM kept off-limits to the CUDA allocator (GB). Capped at 25% of the pool
# on small boards.
# MEMORY_GUARD_RESERVE_GB=12

# Free-RAM floors for the watchdog (GB): below the soft floor training is
# gracefully stopped (checkpoint saved); below the hard floor the job is
# aborted to keep the machine alive. Scaled down automatically on systems
# with less total RAM.
# MEMORY_GUARD_SOFT_FREE_GB=8
# MEMORY_GUARD_HARD_FREE_GB=3

# Watchdog sampling interval (seconds) and forensic log switch
# MEMORY_GUARD_POLL_SECONDS=5
# MEMORY_GUARD_LOG_ENABLED=true

# At the soft floor the watchdog first releases the CUDA allocator's idle
# cache (e.g. eval leftovers) and only stops training if free RAM is still
# below the floor — or if pressure returns within this cooldown (seconds).
# MEMORY_GUARD_RECLAIM_COOLDOWN_SECONDS=60

# ==========================================
# Security & Limits
# ==========================================

# CORS origins (comma-separated list or "*" for all)
# CORS_ORIGINS=*

# Maximum upload file size in MB
# MAX_UPLOAD_SIZE_MB=500

# ==========================================
# llama.cpp Integration (Optional)
# ==========================================
# Merlina uses llama.cpp for GGUF export/quantization and (optionally)
# spinning up llama-server for synthetic rejected-response generation.
#
# Resolution precedence (first hit wins):
#   1. LLAMA_CPP_DIR       — path to a llama.cpp checkout (contains
#                            convert_hf_to_gguf.py and build/bin/)
#   2. LLAMA_CPP_BIN_DIR   — path to a directory of built binaries only
#   3. System PATH         — llama-quantize, llama-server, etc. on PATH
#   4. ./vendor/llama.cpp  — conventional local clone
#
# If none of the above are present, llama.cpp-backed features stay disabled
# in the UI and pre-flight surfaces a warning (never an error).
# LLAMA_CPP_DIR=/opt/llama.cpp
# LLAMA_CPP_BIN_DIR=/opt/llama.cpp/build/bin

# ==========================================
# Object storage tiers (S3-compatible) — optional
# ==========================================
# Two role-named tiers with the same shape. Each can be any S3 API (MinIO,
# Cloudflare R2, AWS, ...). Leave a tier unset to disable it; Merlina then
# loads datasets straight from HuggingFace. See docs/storage-tiers.md and
# docs/internal-dataset-store.md. Older names (S3_*, R2_*, DATASET_STORE,
# PREFER_INTERNAL, MERLINA_ARTIFACT_*) still work but are deprecated:
# `merlina config migrate-env` renames them (dry run unless --write).
#
# Internal tier: the private primary (typically LAN-only). Private data never
# leaves it.
# STORAGE_INTERNAL_ENDPOINT=http://minio.lan:9000
# STORAGE_INTERNAL_BUCKET=datasets
# STORAGE_INTERNAL_ACCESS_KEY=
# STORAGE_INTERNAL_SECRET_KEY=
# STORAGE_INTERNAL_REGION=auto
# Optional admin key, used ONLY for bucket-level operations in the Object
# storage UI / `merlina storage` (list/create/delete buckets, browse buckets
# other than the tier's bucket). Falls back to the key above. For MinIO, a
# service account whose policy allows s3:ListAllMyBuckets, s3:CreateBucket,
# s3:DeleteBucket, s3:GetBucketLocation plus object read/write/delete on the
# buckets it should manage.
# STORAGE_INTERNAL_ADMIN_ACCESS_KEY=
# STORAGE_INTERNAL_ADMIN_SECRET_KEY=
#
# External tier: shared, reachable from rented GPU boxes. Data gets here only
# via `merlina datasets promote` or `merlina storage sync`, which refuse
# anything private.
# STORAGE_EXTERNAL_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# STORAGE_EXTERNAL_BUCKET=merlina-shared
# STORAGE_EXTERNAL_ACCESS_KEY=
# STORAGE_EXTERNAL_SECRET_KEY=
# STORAGE_EXTERNAL_REGION=auto
# Optional admin key (see above). For R2: an account API token with
# "Admin Read & Write".
# STORAGE_EXTERNAL_ADMIN_ACCESS_KEY=
# STORAGE_EXTERNAL_ADMIN_SECRET_KEY=
#
# Which tier THIS process resolves swl:// datasets against: internal (default)
# or external (a rented GPU box sets this and supplies STORAGE_EXTERNAL_*).
# DATASET_TIER=internal
# Mirror "huggingface" sources into the internal tier on first use and serve
# them from there afterwards:
# DATASET_MIRROR=true
# Mirror Hub base models into the model store (models/hf/<org>/<repo>) on
# first use and load them from there afterwards (`merlina models mirror` does
# it by hand). Needs an S3 ARTIFACT_STORE.
# MODEL_MIRROR=true
#
# Where remote runs keep checkpoints/adapters/merged models, and where store:
# models live: a tier name, which reuses that tier's endpoint and keys, or
# hf_hub (private HF repos). Unset = external when STORAGE_EXTERNAL_* is
# configured, else hf_hub.
# Remote (RunPod) runs need "external"; "internal" is LAN-only (local use).
# ARTIFACT_STORE=external
# ARTIFACT_BUCKET=            # optional; defaults to the tier's bucket
# ARTIFACT_PREFIX=merlina/runs

# ==========================================
# Wishcraft hosted pilot (opt-in)
# ==========================================
# Export these through the service environment; hosted settings do not read
# this file automatically. See docs/operations/hosted-pilot.md before enabling.
# Hosted execution uses ARTIFACT_STORE=external (above).
# MERLINA_CHECKPOINT_TIMEOUT_SECONDS=120
# MERLINA_HOSTED_DATA_DIR=/var/lib/merlina-hosted
# MERLINA_HOSTED_PUBLIC_URL=https://merlina.swl.ai
# MERLINA_HOSTED_PAID_EXECUTION_ENABLED=false
# MERLINA_HOSTED_DISPATCH_INTERVAL_SECONDS=10
# MERLINA_HOSTED_MAX_ARTIFACT_BYTES=107374182400
# MERLINA_HOSTED_STRIPE_SECRET_KEY=
# MERLINA_HOSTED_STRIPE_WEBHOOK_SECRET=
# MERLINA_HOSTED_CHECKOUT_SUCCESS_URL=https://merlina.swl.ai/
# MERLINA_HOSTED_CHECKOUT_CANCEL_URL=https://merlina.swl.ai/
# Set policy values only after adopting and disclosing them to participants.
# MERLINA_HOSTED_BILLING_POLICY_VERSION=
# MERLINA_HOSTED_BILLING_FAILURE_POLICY=charge_metered
# MERLINA_HOSTED_BILLING_OVERAGE_POLICY=operator_absorbs
# MERLINA_MEASUREMENT_CATALOG=/etc/merlina/measured-workloads.json
# MERLINA_LIVE_PRICING_URL=https://YOUR-PRICE-SERVICE.example/rates
# MERLINA_ADVISOR_ENABLED=false
# MERLINA_ADVISOR_BASE_URL=https://YOUR-LLM-PROVIDER.example/v1
# MERLINA_ADVISOR_MODEL=
# MERLINA_ADVISOR_API_KEY=
